# Copy to .env.local for local development. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put secrets in them.

# --- App ---
APP_ENV=local                      # local | staging | production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=            # pending owner decision OD-01

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server only
SUPABASE_DB_URL=                   # server/tests only

# --- Payments (OD-02) ---
PAYMENT_PROVIDER=sandbox           # sandbox (local/test only, refused in production) | razorpay
SANDBOX_WEBHOOK_SECRET=            # 32+ random chars; signs sandbox test webhooks (local/test only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=               # server only
RAZORPAY_WEBHOOK_SECRET=           # server only

# --- Jobs ---
CRON_SECRET=                       # bearer token for /api/cron/*

# --- Data protection ---
FIELD_ENCRYPTION_KEY=              # 32-byte base64; encrypts registration/ID numbers

# --- Email / SMS / WhatsApp (OD-07) ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# --- Monitoring & analytics (OD-08) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=    # loaded only after consent
GOOGLE_SITE_VERIFICATION=
